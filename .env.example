# Copie para .env.local e preencha. Nunca commite valores reais.

# ─── Aplicação (frontend) ───
# Somente a URL e a chave pública "anon" podem ter prefixo VITE_ (vão para o navegador; protegidas por RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Testes de banco (arquivo separado: .env.test.local) ───
# Use um projeto Supabase de TESTE. A service_role ignora RLS: NUNCA com prefixo VITE_, nunca no repositório.
# SUPABASE_TEST_URL=
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=

# ─── Fase 5 — Provedor de IA (somente servidor / Edge Function) ───
# Configure nos Secrets da Edge Function, não no frontend:
# AI_PROVIDER=none
# AI_MODEL=
# AI_API_KEY=
# ALLOWED_ORIGIN=
